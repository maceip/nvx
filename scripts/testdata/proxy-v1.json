[
  {
    "name": "strip-and-inject",
    "method": "POST",
    "target": "https://api.example.test/v1/run?x=1",
    "headers": [
      [
        "Authorization",
        "Bearer caller"
      ],
      [
        "X-Api-Key",
        "caller"
      ],
      [
        "Connection",
        "close, x-private"
      ],
      [
        "X-Private",
        "discard"
      ],
      [
        "Content-Type",
        "application/json"
      ]
    ],
    "allowed": [
      [
        "api.example.test",
        443
      ]
    ],
    "bindings": [
      {
        "name": "TEST_KEY",
        "host": "api.example.test",
        "port": 443,
        "value": "fake-host-key",
        "header": "Authorization",
        "prefix": "Bearer ",
        "scheme": "https"
      }
    ],
    "expect": {
      "host": "api.example.test",
      "port": 443,
      "path": "/v1/run?x=1",
      "headers": {
        "authorization": "Bearer fake-host-key",
        "accept-encoding": "identity",
        "content-type": "application/json"
      }
    }
  },
  {
    "name": "evil-host",
    "method": "GET",
    "target": "https://evil.example.test/",
    "headers": [],
    "allowed": [
      [
        "api.example.test",
        443
      ]
    ],
    "bindings": [],
    "error": true
  },
  {
    "name": "hostname-suffix",
    "method": "GET",
    "target": "https://api.example.test.evil.test/",
    "headers": [],
