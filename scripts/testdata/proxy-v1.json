      [
        "Proxy-Authorization",
        "caller"
      ],
      [
        "Cookie",
        "private"
      ],
      [
        "Host",
        "gateway"
      ]
    ],
    "allowed": [
      [
        "api.example.test",
        443
      ]
    ],
    "bindings": [],
    "expect": {
      "host": "api.example.test",
      "port": 443,
      "path": "/v1/status",
      "headers": {
        "accept-encoding": "identity"
      }
    }
  },
