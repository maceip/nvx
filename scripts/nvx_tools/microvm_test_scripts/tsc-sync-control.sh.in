set -eu
fail() {
    code="$1"
    trap - EXIT
    echo "NVX-TSC-CONTROL-FAIL code=$code"
    nvx-exit "$code"
    exit "$code"
}
trap 'status=$?; if [ "$status" -ne 0 ]; then fail "$status"; fi' EXIT

tsc_unstable() {
    kernel_log="$(dmesg)" || fail "$?"
    case "$kernel_log" in
        *"TSC warp"* | *"Marking TSC unstable"* | *"TSC found unstable"*) return 0 ;;
    esac
    return 1
}

online="$(getconf _NPROCESSORS_ONLN)"
[ "$online" -eq @PROCESSORS@ ] || fail 60
case "$(cat /proc/cpuinfo)" in
    *tsc_adjust*) fail 61 ;;
esac
# Boot activated every AP once; each round reactivates them against CPU 0.
activations=$((online - 1))
round=0
while [ "$round" -lt @ROUNDS@ ] && ! tsc_unstable; do
    cpu=1
    while [ "$cpu" -lt "$online" ]; do
        echo 0 >"/sys/devices/system/cpu/cpu$cpu/online" || fail 62
        echo 1 >"/sys/devices/system/cpu/cpu$cpu/online" || fail 63
        activations=$((activations + 1))
        cpu=$((cpu + 1))
    done
    round=$((round + 1))
done
if tsc_unstable; then
    dmesg | grep -E "TSC|tsc:" || true
    echo "NVX-TSC-CONTROL-RESULT unstable activations=$activations"
else
    echo "NVX-TSC-CONTROL-RESULT stable activations=$activations"
fi
echo NVX-TSC-CONTROL-DONE
trap - EXIT
nvx-exit 0
