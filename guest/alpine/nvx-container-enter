#!/bin/sh
set -eu

rootfs=$1
hostname_value=$2
workload_uid=$3
workload_gid=$4
workload_name=$5
workload_home=$6
shift 6
tools=$rootfs/.nvx-agent

mount --make-rprivate /
rm -rf "$tools"
mkdir -p \
    "$tools" \
    "$rootfs/dev/pts" \
    "$rootfs/dev/shm" \
    "$rootfs/proc" \
    "$rootfs/sys"
mount -t tmpfs -o mode=755,nosuid,nodev tmpfs "$tools"
loader=/lib/ld-musl-$(uname -m).so.1
cp "$loader" "$tools/${loader##*/}"
cp /bin/setpriv "$tools/setpriv"
cp /sbin/nvx-seccomp "$tools/nvx-seccomp"
cp -L /usr/lib/libcap-ng.so.0 "$tools/libcap-ng.so.0"
cp -L /usr/lib/libeconf.so.0 "$tools/libeconf.so.0"
chmod 0555 "$tools"/*
mount -o remount,ro,nosuid,nodev "$tools"
mount -t proc -o nosuid,nodev,noexec proc "$rootfs/proc"
mount -t sysfs -o ro,nosuid,nodev,noexec sysfs "$rootfs/sys"
mount -t tmpfs -o mode=755,nosuid tmpfs "$rootfs/dev"
mkdir -p "$rootfs/dev/pts" "$rootfs/dev/shm"
mount -t devpts -o newinstance,ptmxmode=0666,mode=0620 devpts "$rootfs/dev/pts"
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs "$rootfs/dev/shm"

workload_machine_id=/run/nvx/workload-machine-id
[ -f "$workload_machine_id" ] && [ ! -L "$workload_machine_id" ] || exit 125
if [ -L "$rootfs/etc" ] || { [ -e "$rootfs/etc" ] && [ ! -d "$rootfs/etc" ]; }; then
    exit 125
fi
mkdir -p "$rootfs/etc"
rm -f "$rootfs/etc/machine-id"
: >"$rootfs/etc/machine-id"
mount --bind "$workload_machine_id" "$rootfs/etc/machine-id"
mount -o remount,bind,ro,nosuid,nodev "$rootfs/etc/machine-id"

mknod -m 666 "$rootfs/dev/null" c 1 3
mknod -m 666 "$rootfs/dev/zero" c 1 5
mknod -m 666 "$rootfs/dev/full" c 1 7
mknod -m 666 "$rootfs/dev/random" c 1 8
mknod -m 666 "$rootfs/dev/urandom" c 1 9
mknod -m 666 "$rootfs/dev/tty" c 5 0
ln -s pts/ptmx "$rootfs/dev/ptmx"
ln -s /proc/self/fd "$rootfs/dev/fd"
ln -s /proc/self/fd/0 "$rootfs/dev/stdin"
ln -s /proc/self/fd/1 "$rootfs/dev/stdout"
ln -s /proc/self/fd/2 "$rootfs/dev/stderr"

if [ "${NVX_MASKED_PATHS:-1}" = 1 ]; then
    mkdir -p /run/nvx/masks/empty
    : >/run/nvx/masks/file
    chmod 000 /run/nvx/masks/file
    for path in /proc/kcore /proc/keys /proc/timer_list /proc/sysrq-trigger; do
        if [ -e "$rootfs$path" ]; then
            mount --bind /run/nvx/masks/file "$rootfs$path"
            mount -o remount,bind,ro,nosuid,nodev,noexec "$rootfs$path"
        fi
    done
    for path in /proc/acpi /proc/scsi /sys/firmware /sys/devices/virtual/powercap; do
        if [ -d "$rootfs$path" ]; then
            mount --bind /run/nvx/masks/empty "$rootfs$path"
            mount -o remount,bind,ro,nosuid,nodev,noexec "$rootfs$path"
        fi
    done
    mount --bind "$rootfs/proc/sys" "$rootfs/proc/sys"
    mount -o remount,bind,ro,nosuid,nodev,noexec "$rootfs/proc/sys"
fi
hostname "$hostname_value"
export HOME="$workload_home" USER="$workload_name" LOGNAME="$workload_name"
seccomp=${NVX_SECCOMP:-nvx-default}
caps=${NVX_CAPS:-none}
nnp=${NVX_NO_NEW_PRIVS:-1}
unset NVX_SECURITY_PROFILE NVX_SECCOMP NVX_CAPS NVX_MASKED_PATHS NVX_NO_NEW_PRIVS
case "$caps" in
    none)
        bounding=-all
        inherited=-all
        ambient=-all
        ;;
    MKNOD)
        bounding=-all,+mknod
        inherited=-all,+mknod
        ambient=-all,+mknod
        ;;
    ALL)
        bounding=+all
        inherited=-all
        ambient=-all
        ;;
    *) exit 125 ;;
esac
set -- /.nvx-agent/nvx-seccomp "$seccomp" "$@"
if [ "$nnp" = 1 ]; then
    set -- --no-new-privs "$@"
fi
exec chroot "$rootfs" "/.nvx-agent/${loader##*/}" \
    --library-path /.nvx-agent /.nvx-agent/setpriv \
    --reuid "$workload_uid" --regid "$workload_gid" --clear-groups \
    --bounding-set="$bounding" --inh-caps="$inherited" --ambient-caps="$ambient" \
    "$@"
