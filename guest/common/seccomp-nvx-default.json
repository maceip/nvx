  "argument_rules": {
    "clone": {
      "deny_flags": [
        "CLONE_NEWUSER",
        "CLONE_NEWNS",
        "CLONE_NEWNET",
        "CLONE_NEWPID",
        "CLONE_NEWUTS",
        "CLONE_NEWIPC",
        "CLONE_NEWCGROUP"
      ]
    },
    "clone3": {
      "action": "errno:ENOSYS",
      "reason": "classic seccomp cannot inspect the pointed-to clone_args; libc falls back to filtered clone"
    },
    "socket": {
      "allow_domains": [
        "AF_UNIX",
        "AF_INET",
        "AF_INET6"
      ]
    }
  }
}
