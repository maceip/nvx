#!/bin/sh
# Stop the VM, carrying an 8-bit process exit code: through control port
# 0x604 on x86, or the fixed MMIO exit register on ARM (which has no ISA
# port space). The MMIO address must match MmioShutdown::MMIO_BASE.
code=${1:-1}
case "$code" in
    '' | *[!0-9]*) code=1 ;;
esac
if [ "$code" -lt 0 ] || [ "$code" -gt 255 ]; then
    code=1
fi
if [ "$(uname -m)" = "aarch64" ]; then
    /sbin/nvx-mmio-write 0xEF001000 "$code"
    exit $?
fi
octal=$(printf '%03o' "$code")
printf '%b' "\\0$octal" | dd of=/dev/port bs=1 seek=1540 count=1 conv=notrunc 2>/dev/null
